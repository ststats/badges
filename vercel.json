{
    "regions": [
        "icn1"
    ],
    "buildCommand": "node scripts/vercel-public.mjs",
    "outputDirectory": "public",
    "functions": {
        "api/autopost-detect.js": {
            "includeFiles": "{fonts/**,config.json}",
            "memory": 1024,
            "maxDuration": 60
        },
        "api/autopost-source.js": {
            "includeFiles": "{fonts/**,config.json}",
            "memory": 1024,
            "maxDuration": 60
        },
        "api/*.js": {
            "includeFiles": "{fonts/**,config.json}",
            "memory": 1024,
            "maxDuration": 20
        }
    },
    "rewrites": [
        {
            "source": "/:t(soju|staruniv)/:b([a-z0-9-]+).:v([0-9a-f]{12}).png",
            "destination": "/api/img?t=:t&b=:b&v=:v"
        },
        {
            "source": "/:t(soju|staruniv)/:b([a-z0-9-]+).png",
            "destination": "/api/img?t=:t&b=:b"
        },
        {
            "source": "/status",
            "destination": "/api/status"
        },
        {
            "source": "/status.json",
            "destination": "/api/status?format=json"
        }
    ],
    "redirects": [
        {
            "source": "/soju/s",
            "destination": "https://www.sooplive.co.kr/station/soju2022",
            "permanent": false
        },
        {
            "source": "/soju/s/",
            "destination": "https://www.sooplive.co.kr/station/soju2022",
            "permanent": false
        }
    ]
}
