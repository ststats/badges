{
    "buildCommand": "node scripts/vercel-public.mjs",
    "outputDirectory": "public",
    "functions": {
        "api/*.js": {
            "includeFiles": "{fonts/**,schedule.txt,config.json}",
            "memory": 1024,
            "maxDuration": 20
        }
    },
    "rewrites": [
        {
            "source": "/p/:p/notice-:i(\\d).:v([0-9a-f]{12}).png",
            "destination": "/api/img?kind=notice&i=:i&v=:v&p=:p"
        },
        {
            "source": "/p/:p/notice-:i(\\d).png",
            "destination": "/api/img?kind=notice&i=:i&p=:p"
        },
        {
            "source": "/p/:p/schedule.:v([0-9a-f]{12}).png",
            "destination": "/api/img?kind=schedule&v=:v&p=:p"
        },
        {
            "source": "/p/:p/schedule.png",
            "destination": "/api/img?kind=schedule&p=:p"
        },
        {
            "source": "/p/:p/n/:i(\\d)",
            "destination": "/api/go?i=:i&p=:p"
        },
        {
            "source": "/p/:p/n/:i(\\d)/",
            "destination": "/api/go?i=:i&p=:p"
        },
        {
            "source": "/p/:p",
            "destination": "/api/private?p=:p"
        },
        {
            "source": "/p/:p/",
            "destination": "/api/private?p=:p"
        },
        {
            "source": "/notice-:i(\\d).:v([0-9a-f]{12}).png",
            "destination": "/api/img?kind=notice&i=:i&v=:v"
        },
        {
            "source": "/schedule.:v([0-9a-f]{12}).png",
            "destination": "/api/img?kind=schedule&v=:v"
        },
        {
            "source": "/notice-:i(\\d).png",
            "destination": "/api/img?kind=notice&i=:i"
        },
        {
            "source": "/schedule.png",
            "destination": "/api/img?kind=schedule"
        },
        {
            "source": "/n/:i(\\d)",
            "destination": "/api/go?i=:i"
        },
        {
            "source": "/n/:i(\\d)/",
            "destination": "/api/go?i=:i"
        }
    ],
    "redirects": [
        {
            "source": "/s",
            "destination": "https://www.sooplive.co.kr/station/soju2022",
            "permanent": false
        },
        {
            "source": "/s/",
            "destination": "https://www.sooplive.co.kr/station/soju2022",
            "permanent": false
        }
    ]
}
